```gitignore
# Python virtual environment
venv/
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*

# Local databases and backups
db.sqlite3
db_*.sqlite3
*.sqlite3-journal

# User-uploaded media
media/

# Temporary inspection files
project_inspection.txt

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
```